# Public website origin. Use the canonical production domain without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://pulchriflow.com

# Merchant application origin. Marketing calls to action redirect here.
NEXT_PUBLIC_APP_URL=https://app.pulchriflow.com

# Server-side API origin for blog content and other future public data.
PULCHRIFLOW_API_URL=https://api.pulchriflow.com

# Browser-safe API origin for newsletter and marketing-event requests.
NEXT_PUBLIC_API_URL=https://api.pulchriflow.com
